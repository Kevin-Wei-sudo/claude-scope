<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme used before Compose takes over. MaterialComponents.DayNight.NoActionBar avoids
         pulling in the AppCompat action bar and keeps the splash transparent. -->
    <style name="Theme.ClaudeScope" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
